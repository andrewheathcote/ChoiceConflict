# The public repository holds only the code, the supplement, the figures, the recovery results and
# the build list. Everything else in the archive (fits, data, predictives, installed builds, local tools) stays local
# or goes to the Zenodo data record (README.md, "Records").
/*
!/.gitignore
!/.zenodo.json
!/CITATION.cff
!/LICENSE
!/LICENSE-CC-BY-4.0.txt
!/README.md
!/code/
!/doc/
!/figures/
!/recovery/
!/builds/

# build tarballs: release assets of the software record, not in git
/builds/*.tar.gz
# the supplement's first Markdown draft and its build (kept locally): doc/supplement.docx, edited in Word, is the master
/doc/src/
/doc/build.sh
/doc/make_tables.R
/doc/fig/
/doc/supplement.md
# the manuscript and Word lock files
/doc/ConflictEAMs*.docx
~$*
.DS_Store
.Rhistory
